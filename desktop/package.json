{
  "name": "novel-scraper-desktop",
  "version": "1.3.0",
  "description": "Novel Scraper Desktop Application - Standalone High-Performance Novel Downloader & Reader",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
